{
  "routes": [
    {
      "src": "/mingyu-runtime-config.js",
      "dest": "/api/runtime-config"
    },
    {
      "src": "/api/v1/ai/analyze",
      "dest": "/api/v1/ai/analyze"
    },
    {
      "src": "/api/v1/ai/models",
      "dest": "/api/v1/ai/models"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
